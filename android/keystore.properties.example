# Copy this file to android/keystore.properties for local release builds.
# Never commit the copied file or the .jks/.keystore secret.
#
# Example keystore creation:
# keytool -genkeypair -v -keystore flag-arcade-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias flag-arcade-upload

storeFile=flag-arcade-upload.jks
storePassword=replace-with-upload-store-password
keyAlias=flag-arcade-upload
keyPassword=replace-with-upload-key-password
