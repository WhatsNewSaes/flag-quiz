{
  "name": "flag-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/split-country-data.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/split-country-data.ts",
    "build": "tsc && vite build && tsx scripts/generate-seo-pages.ts",
    "typecheck": "tsc",
    "typecheck:all": "tsc -p tsconfig.typecheck.json",
    "build:seo": "tsx scripts/generate-seo-pages.ts",
    "build:mode-og": "tsx scripts/generate-mode-og-images.ts",
    "build:store-assets": "tsx scripts/generate-store-assets.ts",
    "mobile:readiness": "tsx scripts/generate-mobile-readiness-report.ts",
    "package:store-submission": "npm run mobile:readiness && npm run mobile:blockers:check && tsx scripts/package-store-submission.ts && npm run mobile:handoff:check",
    "split-data": "tsx scripts/split-country-data.ts",
    "sync-data": "tsx scripts/fetch-country-data.ts",
    "sync-flags": "tsx scripts/fetch-flag-images.ts",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "mobile:audit": "tsx scripts/mobile-launch-audit.ts",
    "mobile:signing:preflight": "tsx scripts/mobile-signing-preflight.ts",
    "mobile:version:check": "tsx scripts/check-mobile-version-consistency.ts",
    "mobile:urls:check": "tsx scripts/check-mobile-public-urls.ts",
    "mobile:store:check": "tsx scripts/check-mobile-store-submission.ts",
    "mobile:handoff:check": "tsx scripts/check-mobile-store-handoff.ts",
    "mobile:blockers:check": "tsx scripts/check-mobile-launch-blockers.ts",
    "mobile:evidence:init": "tsx scripts/init-mobile-release-evidence.ts",
    "mobile:evidence:check": "tsx scripts/check-mobile-release-evidence.ts",
    "mobile:artifacts:check": "tsx scripts/check-mobile-release-artifacts.ts",
    "mobile:go-live:check": "tsx scripts/mobile-go-live-check.ts",
    "mobile:preflight": "npm run typecheck:all && npm run build:store-assets && npm run mobile:signing:preflight && npm run mobile:version:check && npm run mobile:store:check && npm run mobile:audit && npm run build && npx cap sync && npm run package:store-submission",
    "mobile:build:android:debug": "npm run build && npx cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} ./gradlew assembleDebug",
    "mobile:build:android:release": "npm run build && npx cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} ./gradlew bundleRelease",
    "mobile:build:ios:debug": "npm run build && npx cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO build",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/edge": "^1.3.1",
    "canvas-confetti": "^1.9.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0",
    "react-simple-maps": "^4.0.0-beta.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
